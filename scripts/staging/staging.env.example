# Template for the local staging E2E harness (scripts/staging/local-e2e.mjs).
# Copy to .env.staging.local in the repository root (git-ignored) and fill in the
# values from the Supabase dashboard of the STAGING project lxbcynzgeuqzmynkuzqg
# (Settings -> API). Never use production values; never commit or paste them.

STAGING_SUPABASE_URL=https://lxbcynzgeuqzmynkuzqg.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_CONFIRM=I_UNDERSTAND_THIS_IS_STAGING

# Only for --execute (disposable writes), after explicit approval, dated today (UTC):
# STAGING_WRITES_APPROVED=<approver>@<YYYY-MM-DD>

# Optional
# STAGING_EMAIL_DOMAIN=example.com
