# Safe placeholders only. Never commit a real key.
ZEVQORA_API_HOST=127.0.0.1
ZEVQORA_API_PORT=8000
DATABASE_URL=sqlite:///./zevqora.db

# Local API auth. Every /api/v1 route requires the X-Zevqora-Token header.
# The packaged app mints a token and passes it to the backend; when you start the
# backend yourself it mints one per launch and writes it to ZEVQORA_API_TOKEN_PATH,
# which the Electron shell reads. Leave blank unless you are pinning one.
ZEVQORA_API_TOKEN=
# ZEVQORA_API_TOKEN_PATH=~/.zevqora/api-token
# Host header allowlist (blocks DNS rebinding against 127.0.0.1).
# ZEVQORA_API_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Escape hatch for running the renderer in a plain browser, where no preload
# bridge exists to carry the token. Never set this to 0 in a shipped build.
# ZEVQORA_API_REQUIRE_TOKEN=1

# Zev conversational reasoning. Leave blank for local controlled-tool mode.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://zevqora.vercel.app
ZEVQORA_AGENT_MODEL=openrouter/auto
ZEVQORA_AGENT_MAX_STEPS=6

# Provider / HTTP
ZEVQORA_PROVIDER_TIMEOUT_SECONDS=90
ZEVQORA_PROVIDER_MAX_RETRIES=2
ZEVQORA_MAX_RAW_METADATA_BYTES=4096

# Versioned pricing snapshot path (optional; defaults to packaged fixture)
# ZEVQORA_PRICING_SNAPSHOT=

# Safe subprocess limits (implementation tests)
ZEVQORA_SUBPROCESS_TIMEOUT_SECONDS=180
ZEVQORA_SUBPROCESS_MAX_OUTPUT_BYTES=20000

# Alembic / DB backups (packaging must include alembic.ini + alembic/versions)
# ZEVQORA_ALEMBIC_INI=
# ZEVQORA_DB_BACKUP_DIR=

# Phase 2 — candidate execution (conservative defaults; allowlist only)
ZEVQORA_CANDIDATE_MODELS=mock/test-model
ZEVQORA_MAX_EXPERIMENT_COST_USD=0.50
ZEVQORA_MAX_CANDIDATE_SAMPLES=10
ZEVQORA_MAX_CANDIDATE_CONCURRENCY=2

# Workspace scan
ZEVQORA_SCAN_INTERVAL_SECONDS=20
ZEVQORA_MAX_SOURCE_FILE_BYTES=1000000
