# =========================
# PUBLIC WEBSITE CONFIG
# =========================
PUBLIC_APP_URL=https://zevqora.vercel.app
PUBLIC_DESKTOP_DOWNLOAD_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_CONTACT_EMAIL=zevqora.ai@gmail.com

# =========================
# SERVER-ONLY SUPABASE
# Never expose these in browser JS.
# =========================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =========================
# SERVER-ONLY STRIPE
# =========================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# =========================
# LEGACY DESKTOP BROWSER AUTH HANDOFF (not used by v1.0.5 primary desktop login)
# Generate a random 32-byte base64 value locally and put it only in Vercel.
# Example generation command: openssl rand -base64 32
# =========================
DESKTOP_HANDOFF_SECRET=

# Vercel sends this automatically to the daily cron Authorization header.
CRON_SECRET=
