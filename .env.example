# =========================
# PUBLIC (inlined into the browser bundle by Vite; safe by definition)
# =========================
PUBLIC_APP_URL=https://zevqora.vercel.app
PUBLIC_DESKTOP_DOWNLOAD_URL=https://github.com/ZEVQORA/Zevqora/releases/latest/download/ZEVQORA-Setup.exe
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_CONTACT_EMAIL=zevqora.ai@gmail.com

# =========================
# SERVER-ONLY SUPABASE — never expose in browser JS.
# =========================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =========================
# SERVER-ONLY PLATFORM PROVIDER
# The ZEVQORA platform credential used for cloud replay experiments.
# Users never supply their own key. Never prefix with PUBLIC_ or VITE_.
# =========================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =========================
# SERVER-ONLY STRIPE (optional; checkout stays disabled until set)
# Plan → price mapping lives in the plans table (admin panel); these are legacy fallbacks.
# =========================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# Desktop browser-auth handoff (32-byte base64) and cron protection
DESKTOP_HANDOFF_SECRET=
CRON_SECRET=
