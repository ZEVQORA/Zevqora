  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:release": "node scripts/verify-release.mjs",
    "staging:guard": "node scripts/staging/guard.mjs",
    "test:staging": "node scripts/staging/guard.mjs && vitest run --config vitest.staging.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
